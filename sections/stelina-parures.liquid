{% comment %}Parures : chaque bloc pointe vers un produit « parure » et rappelle sa composition.{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}

<div class="stl-parures color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="stl-section-head">
      {% render 'stelina-star', class: 'stl-section-head__star' %}
      {%- if section.settings.heading != blank -%}
        <h2 class="stl-section-head__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="stl-section-head__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ul class="stl-parures__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title
          if p != blank
            assign title = block.settings.title | default: p.title
          endif
        -%}
        <li
          class="stl-parure{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if p != blank -%}
            <a href="{{ p.url }}" class="stl-parure__link">
          {%- endif -%}
          <div class="stl-parure__media">
            {%- if p.featured_media != blank -%}
              {{
                p.featured_media
                | image_url: width: 900
                | image_tag:
                  widths: '165, 250, 360, 540, 720, 900',
                  sizes: '(min-width: 990px) 270px, (min-width: 750px) 23vw, 44vw',
                  loading: 'lazy',
                  class: 'stl-parure__image',
                  alt: p.featured_media.alt
              }}
            {%- else -%}
              <div class="stl-arch__placeholder">{% render 'stelina-star' %}</div>
            {%- endif -%}
            {%- if p != blank and p.available == false -%}
              <span class="badge stl-parure__badge color-{{ settings.sold_out_badge_color_scheme }}">
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- endif -%}
          </div>
          <h3 class="stl-parure__title">{{ title | escape }}</h3>
          {%- if block.settings.composition != blank -%}
            <p class="stl-parure__composition">{{ block.settings.composition | escape }}</p>
          {%- endif -%}
          {%- if p != blank -%}
            <p class="stl-parure__price">{{ p.price | money }}</p>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="center stl-parures__cta">
        <a href="{{ section.settings.button_link }}" class="button button--secondary">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Stelina · Parures",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "default": "Les parures", "label": "Titre" },
    {
      "type": "select", "id": "heading_size", "label": "Taille du titre", "default": "h1",
      "options": [{ "value": "h2", "label": "Petite" }, { "value": "h1", "label": "Moyenne" }, { "value": "h0", "label": "Grande" }]
    },
    { "type": "richtext", "id": "text", "default": "<p>Deux bijoux pensés pour se porter ensemble.</p>", "label": "Texte" },
    { "type": "text", "id": "button_label", "default": "Voir toutes les parures", "label": "Texte du bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge du haut", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge du bas", "default": 56 }
  ],
  "blocks": [
    {
      "type": "parure",
      "name": "Parure",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit parure", "info": "La photo, le prix et le lien viennent du produit." },
        { "type": "text", "id": "title", "label": "Nom affiché", "info": "Laisse vide pour reprendre le nom du produit." },
        { "type": "text", "id": "composition", "label": "Composition", "info": "Exemple : Papillia + Éclosion" }
      ]
    }
  ],
  "presets": [
    { "name": "Stelina · Parures", "blocks": [{ "type": "parure" }, { "type": "parure" }, { "type": "parure" }, { "type": "parure" }] }
  ]
}
{% endschema %}
