{% comment %}Collection à venir (ex. Bagues) : photos, titre, texte et lien Instagram.{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}

<div class="stl-soon color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="stl-section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="stl-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="stl-section-head__title h0">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- else -%}
          {{ collection.title | escape }}
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="stl-section-head__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="stl-arches stl-arches--{{ section.blocks.size }} stl-arches--even" role="list">
        {%- for block in section.blocks -%}
          <li class="stl-arch" {{ block.shopify_attributes }}>
            <div class="stl-arch__frame">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '165, 250, 360, 540, 720, 900',
                    sizes: '(min-width: 990px) 320px, (min-width: 750px) 30vw, 44vw',
                    class: 'stl-arch__image',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                <div class="stl-arch__placeholder">{% render 'stelina-star' %}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="center stl-soon__cta">
        <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Stelina · Bientôt",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "Bientôt disponible", "label": "Mention au-dessus du titre" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "Laisse vide pour afficher le nom de la collection." },
    { "type": "richtext", "id": "text", "default": "<p>Cette collection arrive bientôt.</p>", "label": "Texte" },
    { "type": "text", "id": "button_label", "default": "Suivre sur Instagram", "label": "Texte du bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge du haut", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge du bas", "default": 56 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [{ "type": "image_picker", "id": "image", "label": "Photo", "info": "Format portrait. Pense au texte alternatif." }] }
  ],
  "presets": [{ "name": "Stelina · Bientôt", "blocks": [{ "type": "photo" }, { "type": "photo" }] }]
}
{% endschema %}
