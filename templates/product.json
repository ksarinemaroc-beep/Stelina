          }
        },
        "stock": {
          "type": "stelina_stock",
          "settings": {}
        },
        "material": {
          "type": "stelina_material",
          "settings": {
            "label": "Matière",
            "value": "Acier inoxydable"
          }
        },
        "linked": {
          "type": "stelina_linked",
          "settings": {
            "heading_piece": "Disponible en parure",
            "heading_set": "Cette parure réunit"
          }
        }
      },
      "block_order": [
        "stock",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "material",
        "description",
        "linked",
        "share"
